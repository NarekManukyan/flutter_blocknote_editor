{
  "name": "blocknote-web-editor",
  "version": "1.0.0",
  "description": "BlockNote React editor for Flutter WebView",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run postbuild:rename-fonts",
    "build:minified": "vite build --minify && npm run postbuild:rename-fonts",
    "build:all": "npm install && npm run build:minified",
    "postbuild:rename-fonts": "node -e \"const fs=require('fs'),p=require('path'),d=p.resolve('../assets/web');for(const f of fs.readdirSync(d)){if(/\\.woff2?$/.test(f)){fs.renameSync(p.join(d,f),p.join(d,f+'.bin'));console.log('renamed',f,'->',f+'.bin');}}\"",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@blocknote/core": "^0.46.1",
    "@blocknote/mantine": "^0.46.1",
    "@blocknote/react": "^0.46.1",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "terser": "^5.46.1",
    "vite": "^5.4.20",
    "vitest": "^2.1.0"
  }
}
